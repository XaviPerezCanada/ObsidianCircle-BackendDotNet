# Variables de entorno — AI Notifications Gateway
# Copia este archivo a .env y rellena tus API keys

# Mismo origen que VITE_NOTIFICATIONS_URL en el client (por defecto http://localhost:3000)
PORT=3000
WORKER_INTERVAL_MS=5000

# ─── Proveedores IA (tier gratuito) ────────────────────────────
# Solo se activan los que tengan key configurada.
# Si ninguno tiene key, el sistema usa respuestas MOCK.
# El sistema rota en orden: Groq → Cerebras → OpenRouter → Gemini → Mistral → Cohere

GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# ─── Resend (envío de emails reales) ────────────────────────
# Obtén tu API key en https://resend.com/api-keys
# Si no se configura, los emails se imprimen en consola (modo dev).
RESEND_API_KEY=
RESEND_FROM_EMAIL=notificaciones@tudominio.com
